{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Integration": {
    "BaseUrl": "https://rescuer-copious-chef.ngrok-free.dev",
    "ConnectHubPath": "/ConnectHub/1.0.0",
    "TokenPath": "/token/1.0.0/oauth2/token",
    "TokenRevokePath": "/token/1.0.0/oauth2/revoke",
    "IntegrationTokenExpirationSafetyMarginSeconds": 30
  },
  "Authentication": {
    "LoginPath": "Auth/login",
    "RegisterPath": "Auth/register",
    "ExternalLoginPath": "Auth/external",
    "RefreshPath": "Auth/refresh",
    "RevokePath": "Auth/revoke",
    "LogoutPath": "Auth/logout"
  },
  "Session": {
    "SecurePolicy": "Always",
    "SameSite": "None"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Google": {
    "CallbackPath": "/auth/google/callback",
    "RedirectUri": "https://localhost:7142/auth/google/callback",
    "FrontendRedirectUri": "http://localhost:4200/home"
  },
  "OpenAI": {
    "Moderation": {
      "Model": "omni-moderation-latest",
      "TimeoutSeconds": 10
    }
  }
}
